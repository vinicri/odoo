<odoo>
  <record id="nfe_additional_information_view_form" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe.additional_information.form</field>
    <field name="model">l10n_br_nfe.nfe.additional_information</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="additional_information" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="nfe_additional_information_view_list" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe.additional_information.list</field>
    <field name="model">l10n_br_nfe.nfe.additional_information</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="additional_information" />
      </list>
    </field>
  </record>

  <record id="nfe_additional_information_action" model="ir.actions.act_window">
    <field name="name">NFE Additional Information</field>
    <field name="res_model">l10n_br_nfe.nfe.additional_information</field>
    <field name="view_mode">form,list</field>
    <field name="view_id" ref="nfe_additional_information_view_list" />
  </record>
</odoo>