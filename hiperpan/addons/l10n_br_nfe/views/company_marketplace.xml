<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="l10n_br_nfe_company_marketplace_form_view" model="ir.ui.view">
    <field name="name">l10n_br_nfe.company.marketplace.form</field>
    <field name="model">l10n_br_nfe.company.marketplace</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="company_id" />
            <field name="provider_id" />
            <field name="marketplace_username" />
          </group>
        </sheet>
      </form>
    </field>
  </record>


  <record id="l10n_br_nfe_company_marketplace_list_view" model="ir.ui.view">
    <field name="name">l10n_br_nfe.company.marketplace.list</field>
    <field name="model">l10n_br_nfe.company.marketplace</field>
    <field name="arch" type="xml">
      <list>
        <field name="company_id" />
        <field name="provider_id" />
        <field name="marketplace_username" />
      </list>
    </field>
  </record>

  <record id="l10n_br_nfe_company_marketplace_action_window" model="ir.actions.act_window">
    <field name="name">Company Marketplace</field>
    <field name="res_model">l10n_br_nfe.company.marketplace</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="l10n_br_nfe_company_marketplace_list_view" />
  </record>

</odoo>
