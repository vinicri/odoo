<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="nfe_series_view_form" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe_series.form</field>
    <field name="model">l10n_br_nfe.nfe.series</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="series" />
            <field name="document_model" />
            <field name="internal_sequence_id" />
            <field name="is_default_for_document_model" />
          </group>
          <notebook>
            <page string="Invalidate Numbers">
              <field name="invalidate_numbers" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="nfe_series_view_list" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe_series.list</field>
    <field name="model">l10n_br_nfe.nfe.series</field>
    <field name="arch" type="xml">
      <list>
        <field name="series" />
        <field name="document_model" />
        <field name="is_default_for_document_model" />
      </list>
    </field>
  </record>

  <record id="nfe_series_action" model="ir.actions.act_window">
    <field name="name">NFE Series</field>
    <field name="res_model">l10n_br_nfe.nfe.series</field>
    <field name="view_mode">form,list</field>
    <field name="view_id" ref="nfe_series_view_list" />
  </record>

</odoo>