<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="nfe_document_line_view_form" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe_document_line.form</field>
    <field name="model">l10n_br_nfe.nfe.document.line</field>
    <field name="arch" type="xml">
      <form>
        <sheet class="nfe_item">
          <field name="is_debug_mode" invisible="1" />
          <group>
            <field name="issuer_id" />
            <field name="operation_nature_id" />
            <field name="operation_type" />
            <field name="destination_id" />
            <field name="emission_finality" />
            <field name="document_model" />

            <field name="product_id" />
            <!-- Campo auxiliar para filtrar CFOP pelo tipo de operação -->
            <field name="operation_nature_id" invisible="1" />
            <field name="cfop_type_in_out" invisible="1" />
            <field name="document_model" invisible="1" />
            <field name="cfop_code_id" options="{'no_create': True, 'no_create_edit': True}" />
          </group>
          <div>
            <group>
              <group>
                <field name="quantity" />
                <field name="unit" />
                <field name="unit_price" />
                <field name="other_expenses_value" />

              </group>
              <group>
                <field name="unit_discount_value" options="{'prefix': 'R$'}" />
                <field name="unit_discount_percent" options="{'suffix': '%'}" />
                <!-- this fields is necessary so any code that uses it gets the correct value -->
                <!-- for some weird reason, if we don't do this, the field value will be False in the model code -->
                <field name="emission_finality" invisible="1" />
              </group>
            </group>
          </div>
          <group>
            <field name="discount_value" />
            <field name="freight_value" readonly="1" />
            <field name="insurance_value" />
            <field name="total_value" />
          </group>
          <notebook>
            <page string="ICMS">
              <div>
                <group>
                  <field name="icms_tax_id" context="{'operation_type': operation_type}" options="{'no_create': True, 'no_create_edit': True}" />
                  <field name="icms_cst_code" invisible="1"/>
                  <field name="icms_cst" invisible="is_debug_mode" />
                  <field name="icms_origin" invisible="is_debug_mode" />
                  <field name="icms_bc_modality" invisible="not has_icms_own_operation" />
                  <field name="is_production_fiscal_type" invisible="1" />
                  <field name="include_ipi_in_icms_bc" widget="ipi_icms_confirmation" invisible="not is_production_fiscal_type or not has_icms_own_operation" />
                  <field name="icms_bc_value" invisible="not has_icms_own_operation" readonly="not is_icms_cst_90_900"/>
                  <field name="icms_bc_reduction_percent" invisible="not is_icms_base_reduction_allowed"/>

                  <field name="icms_tax_percent" invisible="not has_icms_own_operation"/>
                  <field name="icms_value" invisible="not has_icms_own_operation"/>
                </group>

                <field name="is_deferment_cst" invisible="1"/>
                <group invisible="not is_deferment_cst">
                  <separator string="ICMS Diferido"/>
                  <field name="icms_deferment_percent" />
                  <field name="icms_deferment_value" />
                </group>

                <field name="icms_deson_enabled" invisible="1"/>
                <group invisible="not icms_deson_enabled">
                  <separator string="ICMS Desonerado"/>
                  <field name="icms_deson_reason" />
                  <field name="icms_deson_value" invisible="not is_imunne_cst"/>
                </group>

                <field name="allows_icms_sn_credit" invisible="1"/>
                <group invisible="not allows_icms_sn_credit">
                  <separator string="Crédito do ICMS SN"/>
                  <field name="icms_sn_credit_percent" />
                  <field name="icms_sn_credit_value"/>
                </group>
              </div>
              <div>
                <group>
                  <field name="can_have_icms_fcp" invisible="1"/>
                  <group invisible="not can_have_icms_fcp">
                    <field name="icms_fcp_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
                    <field name="icms_fcp_tax_percent" />
                    <field name="icms_fcp_bc_value"/>
                    <field name="icms_fcp_value" />
                  </group>


                </group>
              </div>
            </page>
            <page string="ICMS ST" invisible="not is_icms_st_allowed">
              <group>
                <group>
                  <field name="icms_st_modality" />
                  <field name="icms_st_mva_percent" invisible="not is_icms_st_mva_modality" />
                  <field name="icms_st_bc_value"/>
                  <field name="icms_st_reduction_percent" />
                  <field name="icms_st_tax_percent" />
                  <field name="icms_st_value" />

                </group>
                <group>
                  <field name="icms_st_fcp_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
                  <field name="icms_st_fcp_tax_percent" />
                  <field name="icms_st_fcp_bc_value" />
                  <field name="icms_st_fcp_value" />
                </group>
              </group>
            </page>
            <page string="IPI" invisible="not product_has_ipi">
              <div>
                <group>
                  <field name="ipi_guideline_id" options="{'no_create': True, 'no_create_edit': True}" />
                  <field name="ipi_guideline_code" />
                  <field name="allowed_ipi_tax_ids" invisible="1" />
                  <field name="ipi_tax_id" readonly="forced_ipi_tax_id" context="{'operation_type': operation_type, 'include_cst_name': True}" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="ipi_cst_id" />
                </group>


                <field name="is_ipi_qtt" invisible="1" />

                <group invisible="not is_ipi_with_percentage or is_ipi_qtt">
                  <field name="ipi_tax_percent"/>
                  <field name="ipi_bc_value" />
                </group>

                <group invisible="not is_ipi_qtt">
                  <separator string="Tributado por Unidade"/>
                  <field name="ipi_unit_value" />
                  <field name="ipi_unit_quantity" />
                </group>

                <group>
                  <field name="ipi_value" />
                </group>

              </div>
            </page>
            <page string="PIS COFINS">
              <group>
                <group>
                  <field name="pis_tax_id" readonly="is_simples_nacional" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="pis_cst_id" />
                  <field name="pis_tax_percent" invisible="not is_pis_with_percentage" />
                  <field name="pis_bc_value" invisible="not is_pis_with_percentage" />
                  <field name="pis_bc_quantity" invisible="not is_pis_qtt" />
                  <field name="pis_tax_quantity" invisible="not is_pis_qtt"/>
                  <field name="pis_value" />

                  <separator string="PIS ST"/>
                  <field name="pis_st_tax_id" readonly="is_simples_nacional" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="pis_st_cst_id" />
                  <field name="pis_st_tax_percent" invisible="is_pis_st_qtt" />
                  <field name="pis_st_bc_value" invisible="is_pis_st_qtt" />
                  <field name="pis_st_bc_quantity" invisible="not is_pis_st_qtt" />
                  <field name="pis_st_tax_quantity" invisible="not is_pis_st_qtt"/>
                  <field name="pis_st_value" />
                </group>
                <group>
                  <field name="cofins_tax_id" readonly="is_simples_nacional" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="cofins_cst_id" />
                  <field name="cofins_tax_percent" invisible="not is_cofins_with_percentage" />
                  <field name="cofins_bc_value" invisible="not is_cofins_with_percentage" />
                  <field name="cofins_bc_quantity" invisible="not is_cofins_qtt" />
                  <field name="cofins_tax_quantity" invisible="not is_cofins_qtt"/>
                  <field name="cofins_value" />

                  <separator string="COFINS ST"/>
                  <field name="cofins_st_tax_id" readonly="is_simples_nacional" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="cofins_st_cst_id" />
                  <field name="cofins_st_tax_percent" invisible="is_cofins_st_qtt" />
                  <field name="cofins_st_bc_value" invisible="is_cofins_st_qtt" />
                  <field name="cofins_st_bc_quantity" invisible="not is_cofins_st_qtt" />
                  <field name="cofins_st_tax_quantity" invisible="not is_cofins_st_qtt"/>
                  <field name="cofins_st_value" />
                </group>
              </group>
            </page>


            <field name="is_ii_allowed" invisible="1" />
            <page string="Imposto de Importação" invisible="not is_ii_allowed">
              <group>
                <group>
                  <field name="ii_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
                  <field name="ii_tax_percent" />
                </group>
                <group>
                  <field name="ii_bc_value" />
                  <field name="ii_custom_expenses_value" />
                  <field name="ii_value" />
                </group>
              </group>
            </page>
            <page string="Outros atributos do item">
              <div>
                <group>
                  <field name="include_in_total" />
                  <field name="product_description" />
                  <field name="additional_information" />
                </group>
              </div>
              <group>
                <group>
                  <field name="product_code" />
                  <field name="gtin" />
                  <field name="ncm_code" />
                  <field name="cest_code" />
                  <field name="cfop_code" />
                </group>
                <group>
                  <field name="gtin_trib"/>
                  <field name="unit_trib"/>
                  <field name="quantity_trib"/>
                  <field name="unit_value_trib"/>
                </group>
              </group>
            </page>
            <page string="Tributos Devolvidos" invisible="not is_ipi_returned_allowed">
              <group>
                <field name="total_ipi_returned" />
                <field name="total_product_returned_percentage" />
              </group>
            </page>
            <page string="Tributos Aproximados (IBPT)">
              <!-- <div class="oe_button_box" name="ibpt_button_box">
                <button name="action_fetch_ibpt_taxes" type="object" string="Buscar IBPT" class="btn-primary" icon="fa-download" help="Buscar tributos aproximados do IBPT para este item"/>
              </div> -->
              <group>
                <group string="Valores Aproximados dos Tributos">
                  <field name="approximate_federal_tax_amount" />
                  <field name="approximate_state_tax_amount" />
                  <field name="approximate_municipal_tax_amount" />
                  <field name="approximate_tax_amount" />
                </group>
                <group>
                  <div class="alert alert-info" role="alert">
                    <p>
                      <strong>Lei 12.741/2012</strong>
                    </p>
                    <p>Os valores de tributos aproximados são obtidos através da API do IBPT (De Olho no Imposto) e devem ser informados na Nota Fiscal.</p>
                    <p>Configure o token IBPT nas configurações da empresa.</p>
                  </div>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="nfe_document_line_view_list" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe_document_line.list</field>
    <field name="model">l10n_br_nfe.nfe.document.line</field>
    <field name="arch" type="xml">
      <list>
        <field name="item_number" />
        <field name="product_code" />
        <field name="product_id" />
        <field name="product_description" />
        <field name="ncm_code" />
        <field name="ncm_unmasked" invisible="1"/>
        <field name="cest_code" />
        <field name="cfop_code" />
        <field name="unit" />
        <field name="quantity" />
        <field name="unit_price" />
        <field name="freight_value" />
        <field name="unit_discount_value" />
        <field name="discount_value" />
        <field name="total_value" />
        <!-- Hidden fields needed for total calculations and JS widgets -->
        <field name="insurance_value" column_invisible="1" />
        <field name="freight_value" column_invisible="1" />
        <field name="other_expenses_value" column_invisible="1" />
      </list>
    </field>
  </record>




  <record id="nfe_document_line_action" model="ir.actions.act_window">
    <field name="name">NFE Document</field>
    <field name="res_model">l10n_br_nfe.nfe.document.line</field>
    <field name="view_mode">form,list</field>
    <field name="view_id" ref="nfe_document_line_view_list" />
  </record>

</odoo>