<odoo>
  <record id="nfe_document_payment_view" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe_document_payment.form</field>
    <field name="model">l10n_br_nfe.nfe.document.payment</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="type" />
            <field name="payment_method" />
            <field name="payment_value" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="nfe_document_payment_view_list" model="ir.ui.view">
    <field name="name">l10n_br_nfe.nfe_document_payment.list</field>
    <field name="model">l10n_br_nfe.nfe.document.payment</field>
    <field name="arch" type="xml">
      <list>
        <field name="type" />
        <field name="payment_method" />
        <field name="payment_value" />
      </list>
    </field>
  </record>

  <record id="nfe_document_payment_action" model="ir.actions.act_window">
    <field name="name">NFE Document Payment</field>
    <field name="res_model">l10n_br_nfe.nfe.document.payment</field>
    <field name="view_mode">form,list</field>
    <field name="view_id" ref="nfe_document_payment_view_list" />
  </record>
</odoo>