<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="l10n_br_certificate_res_company_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal_certificate.res.company.form</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="l10n_br.view_company_form" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='branches']" position="after">
        <page name="certificate" string="Certificates">
          <group name="certificate" string="Certificate">
            <group>
              <field name="l10n_br_certificate_ecnpj_id" />
            </group>
            <group>
              <field name="l10n_br_certificate_nfe_id" />
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
