<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="l10n_br_certificate_res_company_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal_certificate.res.company.form</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="l10n_br.view_company_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='accountant_id']" position="after">
        <field name="certificate_ecnpj_id" />
        <field name="certificate_nfe_id" />
      </xpath>
    </field>
  </record>
</odoo>
