<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <data>

    <record id="view_l10n_br_certificate_certificate_search" model="ir.ui.view">
      <field name="name">l10n_br_certificate.certificate.search</field>
      <field name="model">l10n_br_certificate.certificate</field>
      <field name="arch" type="xml">
        <search string="Certificate">
          <field name="name" />
        </search>
      </field>
    </record>

    <record id="view_l10n_br_certificate_certificate_list" model="ir.ui.view">
      <field name="name">l10n_br_certificate.certificate.list</field>
      <field name="model">l10n_br_certificate.certificate</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" />
          <field name="type" />
        </list>
      </field>
    </record>

    <record id="view_l10n_br_certificate_certificate_form" model="ir.ui.view">
      <field name="name">l10n_br_certificate.certificate.form</field>
      <field name="model">l10n_br_certificate.certificate</field>
      <field name="priority">1000</field>
      <field name="arch" type="xml">
        <form string="Certificate">
          <sheet>
            <div>
              <h1 class="mt0">
                <field name="name" class="oe_inline" invisible="name == True" />
              </h1>
            </div>
            <!-- <div class="oe_button_box" name="button_box">

            <field name="active" invisible="1" />
            <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True" />

          </div> -->
            <group>
              <field name="type" />
              <field name="subtype" />
              <field name="file_name" invisible="1" />
              <field name="file" filename="file_name" string="File" />
              <field name="password" password="True" />
            </group>


            <group string="Certificate Infos" invisible="file == False">
              <field name="issuer_name" readonly="1" />
              <field name="owner_name" readonly="1" />
              <field name="owner_cnpj_cpf" readonly="1" />
              <field name="date_start" force_save="1" readonly="1" />
              <field name="date_expiration" force_save="1" readonly="1" />
              <field name="is_valid" readonly="1" />
            </group>
          </sheet>

        </form>
        <!-- <div class="oe_chatter">
          <field name="message_follower_ids" groups="base.group_user" />
          <field name="activity_ids" />
          <field name="message_ids" />
        </div> -->
      </field>
    </record>

    <record id="certificate_action" model="ir.actions.act_window">
      <field name="name">Certificate</field>
      <field name="res_model">l10n_br_certificate.certificate</field>
      <field name="view_mode">list,form</field>
      <field name="search_view_id" ref="view_l10n_br_certificate_certificate_search"/>
      <field name="view_id" ref="view_l10n_br_certificate_certificate_list"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
        Add a new Certificate
        </p>
        <p>
        All Certificate by
        Brazilian Fiscal modulo for Odoo.
        </p>
      </field>
    </record>

    <menuitem id="certificate_menu" action="certificate_action" groups="base.group_user" sequence="40" />
  </data>
</odoo>
