<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form" model="ir.ui.view">
    <field name="name">res.company.form</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="l10n_br.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_br_cpf_code']" position="replace">
      </xpath>
      <xpath expr="//label[@for='street']" position="replace">
      </xpath>
      <xpath expr="//div[@class='o_address_format']" position="replace">
      </xpath>
      <xpath expr="//field[@name='vat']" position="replace">
      </xpath>
      <xpath expr="//field[@name='company_registry']" position="replace">
      </xpath>
      <xpath expr="//field[@name='l10n_br_nire_code']" position="replace">
      </xpath>
      <xpath expr="//field[@name='l10n_br_ie_code']" position="replace">
      </xpath>
      <xpath expr="//field[@name='l10n_br_im_code']" position="replace">
      </xpath>


      <xpath expr="//field[@name='phone']" position="replace">
        <field name="phone" placeholder="Telefone com DDD"/>
      </xpath>

      <xpath expr="//field[@name='mobile']" position="replace">
        <field name="mobile" placeholder="Celular com DDD"/>
      </xpath>




      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="legal_name" string="Nome legal"/>
        <field name="trade_name" string="Nome Fantasia"/>
        <field name="formatted_cnpj_cpf" string="CNPJ/CPF"/>
        <field name="inscr_est" string="Inscrição Estadual"/>
        <field name="no_inscr_est" string="Não tem Inscrição Estadual" />
        <field name="inscr_mun" string="Inscrição Municipal"/>
        <field name="street" placeholder="Logradouro sem o número" string="Logradouro"/>
        <field name="street_number" placeholder="Número sem complemento" string="Número"/>
        <field name="street_complement" string="Complemento"/>
        <field name="district" string="Bairro"/>
        <field name="country_id" placeholder="País" options='{"no_open": True, "no_create": True}' />
        <field name="state_id" class="o_address_state" placeholder="Estado" options='{"no_open": True}' />
        <field name="city_id" string="Cidade" options='{"no_open": True, "no_create": True}' />
        <field name="zip" placeholder="CEP" class="o_address_zip"/>
        <field name="suframa" string="SUFRAMA"/>
      </xpath>
      <xpath expr="//page[@name='branches']" position="after">
        <page name="fiscal" string="Fiscal">
          <group>
            <field name="accountant_id" string="Contador" />
          </group>
        </page>
      </xpath>
    </field>

  </record>
</odoo>
