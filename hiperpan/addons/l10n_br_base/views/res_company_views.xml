<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form" model="ir.ui.view">
    <field name="name">res.company.form</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="l10n_br.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='l10n_br_cpf_code']" position="replace">
      </xpath>
      <!-- <xpath expr="//field[@name='vat']" position="replace">
        <field name="vat" widget="mask" data-mask="00.000.000/0000-00" placeholder="00.000.000/0000-00"/>
      </xpath> -->
      <xpath expr="//field[@name='l10n_br_nire_code']" position="after">
        <field name="l10n_br_base_accountant_id" string="Accountant" />
      </xpath>
      <xpath expr="//field[@name='vat']" position="before">
        <field name="l10n_br_base_country_id" string="Country"/>
        <field name="l10n_br_base_state_id" string="State"/>
        <field name="l10n_br_base_city_id" string="City"/>
        <field name="l10n_br_base_cnpj_cpf" string="CNPJ/CPF"/>
        <field name="l10n_br_base_inscr_est" string="State Tax Number"/>
        <field name="l10n_br_base_rg" string="RG" nolabel="0"/>
        <field name="l10n_br_base_inscr_mun" string="Municipal Tax Number"/>
      </xpath>
    </field>

  </record>
</odoo>
