<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="res_partner_form_view" model="ir.ui.view">
      <field name="name">res.partner.form</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//page[@name='sales_purchases']" position="after">
          <page name="accountant_info" string="Accountant Info">
            <group>
              <field name="l10n_br_base_is_accountant" string="Is accountant?" />
              <field name="l10n_br_base_is_accountant_crc_code" string="CRC Code" invisible="not l10n_br_base_is_accountant"/>
            </group>
          </page>
        </xpath>
        <xpath expr="//field[@name='l10n_br_ie_code']" position="before">
          <field name="l10n_br_base_cnpj_cpf" string="CNPJ/CPF"/>
          <field name="l10n_br_base_inscr_est" string="State Tax Number"/>
          <field name="l10n_br_base_rg" string="RG" nolabel="0"/>
          <field name="l10n_br_base_inscr_mun" string="Municipal Tax Number"/>
        </xpath>
      </field>
    </record>


  </data>
</odoo>