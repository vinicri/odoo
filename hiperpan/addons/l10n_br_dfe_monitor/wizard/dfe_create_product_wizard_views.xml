<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dfe_create_product_wizard_form" model="ir.ui.view">
    <field name="name">l10n_br_dfe_monitor.create_product_wizard.form</field>
    <field name="model">l10n_br_dfe_monitor.create_product_wizard</field>
    <field name="arch" type="xml">
      <form string="Criar Produto">
        <field name="proc_nfe_item_id" invisible="1"/>
        <field name="image_search_results_json" invisible="1"/>
        <field name="price_calc_quantity_per_line_unit" invisible="1"/>
        <field name="price_calc_margin" invisible="1"/>
        <widget name="dfe_product_image_search"/>
        <group>
          <group string="Geral">
            <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920', 'size': [128, 128]}"/>
            <field name="categ_id"/>
            <field name="name"/>
            <field name="type"/>
            <field name="is_storable"/>
            <field name="available_in_pos"/>
            <field name="default_code" readonly="1"/>
            <field name="barcode" invisible="no_barcode"/>
            <field name="no_barcode"/>
            <field name="uom_id"/>
            <label for="list_price"/>
            <div class="o_row">
              <field name="list_price" nolabel="1"/>
              <widget name="dfe_price_calculator_button"/>
            </div>
            <!-- <field name="company_id" groups="base.group_multi_company"/> -->
          </group>
          <group string="Informações Fiscais">
            <field name="fiscal_type_id"/>
            <field name="icms_origin_id"/>
            <field name="ncm_id"/>
            <field name="cest_id"/>
            <field name="fiscal_additional_information"/>
          </group>
        </group>
        <!--
          No <footer>: the FormViewDialog renders its native "Salvar & Fechar"
          button, whose save closes only this dialog (avoiding the modal-stack
          cascade a custom object-button caused). Product creation runs in the
          widget's onRecordSaved after the wizard record is saved.
        -->
      </form>
    </field>
  </record>
</odoo>
