<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dfe_query_wizard_form" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.query.wizard.form</field>
        <field name="model">l10n_br_dfe_monitor.query.wizard</field>
        <field name="arch" type="xml">
            <form string="Consultar DFes - SEFAZ">
                <group>
                    <field name="query_type" widget="radio"/>
                    <field name="nsu"
                           invisible="query_type != 'consNSU'"
                           required="query_type == 'consNSU'"/>
                    <field name="ch_nfe"
                           invisible="query_type != 'consChNFe'"
                           required="query_type == 'consChNFe'"/>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" widget="text" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_consult"
                            string="Consultar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Fechar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dfe_query_wizard" model="ir.actions.act_window">
        <field name="name">Consultar DFes</field>
        <field name="res_model">l10n_br_dfe_monitor.query.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
