<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_dfe_create_partner_wizard_form" model="ir.ui.view">
    <field name="name">l10n_br_dfe_monitor.create_partner_wizard.form</field>
    <field name="model">l10n_br_dfe_monitor.create_partner_wizard</field>
    <field name="arch" type="xml">
      <form string="Criar Parceiro Emitente">
        <field name="proc_nfe_id" invisible="1"/>
        <group string="Dados do Emitente">
          <field name="company_type"/>
          <field name="vat"/>
          <field name="legal_name"/>
          <field name="trade_name"/>
          <field name="name"/>
          <field name="phone"/>
          <field name="main_cnae_id" readonly="1"/>
          <field name="fiscal_framework" readonly="1"/>
        </group>
        <group string="Endereço">
          <field name="street"/>
          <field name="street_number"/>
          <field name="street_complement"/>
          <field name="district"/>
          <field name="zip"/>
          <field name="inscr_est"/>
          <field name="no_inscr_est"/>
          <field name="inscr_mun"/>
          <field name="city_id"/>
          <field name="state_id"/>
          <field name="country_id"/>

        </group>
        <footer>
          <button name="action_create_partner" string="Criar e Continuar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
