<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_br_dfe_monitor.ProductImageSearch">
        <div class="o_dfe_product_image_search mb-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <strong>Sugestões de Imagem</strong>
                <button type="button" class="btn btn-sm btn-secondary" t-att-disabled="state.loading" t-on-click="search">
                    <i class="fa fa-refresh me-1"/>
Buscar Imagens
                </button>
                <button t-if="showBarcodeSearch" type="button" class="btn btn-sm btn-outline-secondary" t-att-disabled="state.loading" t-on-click="searchByBarcode">
                    <i class="fa fa-barcode me-1"/>
Buscar pelo Código de Barras
                </button>
                <span t-if="state.loading" class="fa fa-spinner fa-spin"/>
            </div>
            <div t-if="state.error" class="alert alert-warning py-1 px-2 mb-2" role="alert">
                <t t-esc="state.error"/>
            </div>
            <div t-if="!state.loading and !state.candidates.length and !state.error" class="text-muted">
                Nenhuma imagem encontrada. Ajuste o nome do produto e clique em "Buscar Imagens".
            </div>
            <div class="d-flex flex-wrap gap-2">
                <t t-foreach="state.candidates" t-as="candidate" t-key="candidate.image_url">
                    <div t-attf-class="o_dfe_image_candidate border rounded p-1 {{ state.selectedUrl === candidate.image_url ? 'border-primary border-3' : '' }}" style="cursor:pointer;position:relative;" t-on-click="() => this.selectImage(candidate)">
                        <img t-att-src="candidate.thumbnail" style="max-width:100px;max-height:100px;display:block;"/>
                        <span class="o_dfe_image_candidate_zoom position-absolute bottom-0 end-0 m-1 d-flex align-items-center justify-content-center bg-dark bg-opacity-75 rounded-circle text-white"
                              style="width:22px;height:22px;cursor:zoom-in;"
                              title="Ver em tamanho real"
                              t-on-click="(ev) => this.previewImage(candidate, ev)">
                            <i class="fa fa-search-plus" style="font-size:11px;"/>
                        </span>
                    </div>
                </t>
            </div>
            <div class="text-muted mt-2">
                Se nenhuma das imagens corresponde ao produto, digite o código de barras pra uma busca mais precisa.
            </div>
        </div>
    </t>

    <t t-name="l10n_br_dfe_monitor.ImagePreviewDialog">
        <Dialog title="'Imagem em Tamanho Real'" size="'lg'">
            <div class="text-center">
                <img t-att-src="props.imageUrl" style="max-width:100%;max-height:75vh;"/>
            </div>
        </Dialog>
    </t>

</templates>
