<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_company_form_dfe_receiving_schedule" model="ir.ui.view">
    <field name="name">res.company.form.dfe.receiving.schedule</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <notebook position="inside">
        <page string="Recebimento de Mercadorias" name="dfe_receiving_schedule">
          <p class="text-muted">
            Dias e horários em que a empresa costuma receber mercadorias de
            fornecedores. Usado para sugerir a Data de Chegada ao escriturar
            uma NF-e a partir de NF-e Processadas.
          </p>
          <field name="dfe_receiving_schedule_ids">
            <list editable="bottom">
              <field name="weekday"/>
              <field name="hour_from" widget="float_time"/>
              <field name="hour_to" widget="float_time"/>
            </list>
          </field>
        </page>
        <page string="Precificação de Produtos" name="dfe_product_pricing">
          <p class="text-muted">
            Margem padrão sugerida ao calcular o preço de venda de um produto
            criado a partir de uma NF-e.
          </p>
          <group>
            <field name="dfe_default_product_margin"/>
          </group>
        </page>
        <page string="Busca de Imagens" name="dfe_google_image_search">
          <p class="text-muted">
            Credenciais usadas para sugerir imagens ao criar um produto a
            partir de uma NF-e.
          </p>
          <group>
            <field name="dfe_image_search_provider"/>
          </group>
          <group string="Google Custom Search" invisible="dfe_image_search_provider != 'google'">
            <p class="text-muted" colspan="2">
              Requer um mecanismo de busca (Programmable Search Engine)
              configurado para pesquisar a Web inteira com busca de imagens
              habilitada.
            </p>
            <field name="dfe_google_api_key" password="True"/>
            <field name="dfe_google_search_cx"/>
          </group>
          <group string="SerpApi" invisible="dfe_image_search_provider != 'serpapi'">
            <field name="dfe_serpapi_key" password="True"/>
          </group>
        </page>
      </notebook>
    </field>
  </record>

</odoo>
