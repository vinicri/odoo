<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_dfe_proc_nfe_list" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.proc_nfe.list</field>
        <field name="model">l10n_br_dfe_monitor.proc_nfe</field>
        <field name="arch" type="xml">
            <list string="NF-e Processadas">
                <field name="dh_emi" string="Dt. Emissão"/>
                <field name="serie" string="Série"/>
                <field name="n_nf" string="Nº NF"/>
                <field name="emit_x_nome" string="Emitente"/>
                <field name="emit_ender_UF" string="UF"/>
                <field name="tp_nf"/>
                <field name="v_nf" string="Valor Total"/>
                <field name="tp_amb"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dfe_proc_nfe_form" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.proc_nfe.form</field>
        <field name="model">l10n_br_dfe_monitor.proc_nfe</field>
        <field name="arch" type="xml">
            <form string="NF-e Processada">
                <sheet>
                    <group string="Empresa">
                        <field name="company_id"/>
                        <field name="dfe_document_id"/>
                    </group>
                    <group string="Identificação">
                        <group>
                            <field name="ch_nfe"/>
                            <field name="versao"/>
                            <field name="c_uf"/>
                            <field name="mod"/>
                            <field name="serie"/>
                            <field name="n_nf"/>
                            <field name="nat_op"/>
                        </group>
                        <group>
                            <field name="tp_nf"/>
                            <field name="tp_amb"/>
                            <field name="fin_nfe"/>
                            <field name="ind_final"/>
                            <field name="ind_pres"/>
                            <field name="id_dest"/>
                            <field name="ind_intermed"/>
                        </group>
                        <group>
                            <field name="dh_emi"/>
                            <field name="dh_sai_ent"/>
                        </group>
                        <group>
                            <field name="tp_imp"/>
                            <field name="tp_emis"/>
                            <field name="proc_emi"/>
                        </group>
                    </group>
                    <group string="Emitente">
                        <group>
                            <field name="emit_cnpj"/>
                            <field name="emit_cpf"/>
                            <field name="emit_x_nome"/>
                            <field name="emit_x_fant"/>
                        </group>
                        <group string="Endereço">
                            <field name="emit_ender_x_lgr"/>
                            <field name="emit_ender_nro"/>
                            <field name="emit_ender_xCpl"/>
                            <field name="emit_ender_xBairro"/>
                        </group>
                        <group string="Localização">
                            <field name="emit_ender_cMun"/>
                            <field name="emit_ender_xMun"/>
                            <field name="emit_ender_UF"/>
                            <field name="emit_ender_CEP"/>
                            <field name="emit_ender_cPais"/>
                            <field name="emit_ender_xPais"/>
                        </group>
                        <group string="Contato">
                            <field name="emit_ender_fone"/>
                        </group>
                        <group string="Cadastro Fiscal">
                            <field name="emit_ie"/>
                            <field name="emit_iest"/>
                            <field name="emit_im"/>
                            <field name="emit_cnae"/>
                            <field name="emit_crt"/>
                        </group>
                    </group>
                    <group string="Destinatário">
                        <group>
                            <field name="dest_cnpj"/>
                            <field name="dest_cpf"/>
                            <field name="dest_id_estrangeiro"/>
                            <field name="dest_x_nome"/>
                        </group>
                        <group>
                            <field name="dest_ind_ie"/>
                            <field name="dest_ie"/>
                            <field name="dest_isuf"/>
                            <field name="dest_im"/>
                        </group>
                        <group string="Endereço">
                            <field name="dest_ender_x_lgr"/>
                            <field name="dest_ender_nro"/>
                            <field name="dest_ender_xCpl"/>
                            <field name="dest_ender_xBairro"/>
                        </group>
                        <group string="Localização">
                            <field name="dest_ender_cMun"/>
                            <field name="dest_ender_xMun"/>
                            <field name="dest_ender_UF"/>
                            <field name="dest_ender_CEP"/>
                            <field name="dest_ender_cPais"/>
                            <field name="dest_ender_xPais"/>
                        </group>
                        <group string="Contato">
                            <field name="dest_ender_fone"/>
                            <field name="dest_email"/>
                        </group>
                    </group>
                    <group string="Transporte">
                        <group>
                            <field name="transp_mod_frete"/>
                            <field name="transp_placa"/>
                            <field name="transp_uf_veic"/>
                            <field name="transp_rntc"/>
                        </group>
                        <group string="Transportador">
                            <field name="transp_cnpj"/>
                            <field name="transp_cpf"/>
                            <field name="transp_x_nome"/>
                            <field name="transp_ie"/>
                            <field name="transp_x_ender"/>
                            <field name="transp_x_mun"/>
                            <field name="transp_uf"/>
                        </group>
                        <group string="Retenção ICMS Transporte">
                            <field name="transp_v_serv"/>
                            <field name="transp_v_bc_ret"/>
                            <field name="transp_p_icms_ret"/>
                            <field name="transp_v_icms_ret"/>
                            <field name="transp_cfop"/>
                            <field name="transp_c_mun_fg"/>
                        </group>
                    </group>
                    <group string="Totais">
                        <group>
                            <field name="v_bc"/>
                            <field name="v_icms"/>
                            <field name="v_icms_deson"/>
                            <field name="v_fcp_uf_dest"/>
                            <field name="v_icms_uf_dest"/>
                            <field name="v_icms_uf_remet"/>
                            <field name="v_fcp"/>
                        </group>
                        <group>
                            <field name="v_bc_st"/>
                            <field name="v_st"/>
                            <field name="v_fcp_st"/>
                            <field name="v_fcp_st_ret"/>
                        </group>
                        <group>
                            <field name="v_prod"/>
                            <field name="v_frete"/>
                            <field name="v_seg"/>
                            <field name="v_desc"/>
                            <field name="v_ii"/>
                            <field name="v_ipi"/>
                            <field name="v_ipi_devol"/>
                        </group>
                        <group>
                            <field name="v_pis"/>
                            <field name="v_cofins"/>
                            <field name="v_outro"/>
                            <field name="v_nf"/>
                            <field name="v_tot_trib"/>
                        </group>
                    </group>
                    <group string="Informações Adicionais">
                        <field name="inf_cpl" nolabel="1"/>
                        <field name="inf_ad_fisco" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Itens">
                            <field name="item_ids" readonly="1">
                                <list>
                                    <field name="n_item" string="Item"/>
                                    <field name="c_prod" string="Código"/>
                                    <field name="x_prod" string="Descrição"/>
                                    <field name="ncm"/>
                                    <field name="cfop"/>
                                    <field name="u_com" string="Un."/>
                                    <field name="q_com" string="Qtd."/>
                                    <field name="v_un_com" string="Vlr. Unit."/>
                                    <field name="v_prod" string="Vlr. Total"/>
                                    <field name="v_desc" string="Desc."/>
                                    <field name="ind_tot"/>
                                    <field name="icms_orig" optional="hide"/>
                                    <field name="icms_cst_csosn" optional="hide"/>
                                    <field name="icms_v_bc" optional="hide"/>
                                    <field name="icms_p_icms" optional="hide"/>
                                    <field name="icms_v_icms" optional="hide"/>
                                    <field name="icms_v_bc_st" optional="hide"/>
                                    <field name="icms_p_icms_st" optional="hide"/>
                                    <field name="icms_v_icms_st" optional="hide"/>
                                    <field name="icms_v_icms_st_ret" optional="hide"/>
                                    <field name="icms_v_fcp" optional="hide"/>
                                    <field name="icms_v_fcp_st" optional="hide"/>
                                    <field name="ipi_cst" optional="hide"/>
                                    <field name="ipi_v_ipi" optional="hide"/>
                                    <field name="ii_v_ii" optional="hide"/>
                                    <field name="pis_cst" optional="hide"/>
                                    <field name="pis_v_pis" optional="hide"/>
                                    <field name="pisst_v_pis" optional="hide"/>
                                    <field name="cofins_cst" optional="hide"/>
                                    <field name="cofins_v_cofins" optional="hide"/>
                                    <field name="cofinsst_v_cofins" optional="hide"/>
                                </list>
                                <form string="Item NF-e">
                                    <sheet>
                                        <group string="Produto">
                                            <group>
                                                <field name="n_item"/>
                                                <field name="c_prod"/>
                                                <field name="c_ean"/>
                                                <field name="x_prod"/>
                                                <field name="ncm"/>
                                                <field name="nve"/>
                                                <field name="cest"/>
                                                <field name="ind_escala"/>
                                                <field name="cnpj_fab"/>
                                                <field name="c_benef"/>
                                                <field name="ex_tipi"/>
                                            </group>
                                            <group>
                                                <field name="cfop"/>
                                                <field name="u_com"/>
                                                <field name="q_com"/>
                                                <field name="v_un_com"/>
                                                <field name="v_prod"/>
                                                <field name="c_ean_trib"/>
                                                <field name="u_trib"/>
                                                <field name="q_trib"/>
                                                <field name="v_un_trib"/>
                                                <field name="v_frete"/>
                                                <field name="v_seg"/>
                                                <field name="v_desc"/>
                                                <field name="v_outro"/>
                                                <field name="ind_tot"/>
                                            </group>
                                        </group>
                                        <group string="Informações Adicionais do Produto">
                                            <field name="inf_ad_prod" nolabel="1"/>
                                        </group>
                                        <group string="ICMS">
                                            <group string="Identificação">
                                                <field name="icms_orig"/>
                                                <field name="icms_cst_csosn"/>
                                                <field name="icms_mod_bc"/>
                                            </group>
                                            <group string="ICMS Próprio">
                                                <field name="icms_v_bc"/>
                                                <field name="icms_p_red_bc"/>
                                                <field name="icms_p_icms"/>
                                                <field name="icms_v_icms"/>
                                            </group>
                                            <group string="FCP">
                                                <field name="icms_v_bc_fcp"/>
                                                <field name="icms_p_fcp"/>
                                                <field name="icms_v_fcp"/>
                                            </group>
                                            <group string="Simples Nacional">
                                                <field name="icms_p_cred_sn"/>
                                                <field name="icms_v_cred_icms_sn"/>
                                            </group>
                                            <group string="ICMS ST">
                                                <field name="icms_mod_bc_st"/>
                                                <field name="icms_p_mva_st"/>
                                                <field name="icms_p_red_bc_st"/>
                                                <field name="icms_v_bc_st"/>
                                                <field name="icms_p_icms_st"/>
                                                <field name="icms_v_icms_st"/>
                                            </group>
                                            <group string="FCP ST">
                                                <field name="icms_v_bc_fcp_st"/>
                                                <field name="icms_p_fcp_st"/>
                                                <field name="icms_v_fcp_st"/>
                                            </group>
                                            <group string="ST Retido">
                                                <field name="icms_v_bc_st_ret"/>
                                                <field name="icms_p_st"/>
                                                <field name="icms_v_icms_substituto"/>
                                                <field name="icms_v_icms_st_ret"/>
                                                <field name="icms_v_bc_fcp_st_ret"/>
                                                <field name="icms_p_fcp_st_ret"/>
                                                <field name="icms_v_fcp_st_ret"/>
                                            </group>
                                            <group string="ICMS Efetivo">
                                                <field name="icms_p_red_bc_efet"/>
                                                <field name="icms_v_bc_efet"/>
                                                <field name="icms_p_icms_efet"/>
                                                <field name="icms_v_icms_efet"/>
                                            </group>
                                            <group string="Desoneração / Diferimento">
                                                <field name="icms_v_icms_deson"/>
                                                <field name="icms_mot_des_icms"/>
                                                <field name="icms_p_dif"/>
                                                <field name="icms_v_icms_dif"/>
                                                <field name="icms_v_icms_op"/>
                                            </group>
                                            <group string="ICMS UF Destino (Interestadual)">
                                                <field name="icms_ufdest_v_bc_uf_dest"/>
                                                <field name="icms_ufdest_v_bc_fcp_uf_dest"/>
                                                <field name="icms_ufdest_p_fcp_uf_dest"/>
                                                <field name="icms_ufdest_p_icms_uf_dest"/>
                                                <field name="icms_ufdest_p_icms_inter"/>
                                                <field name="icms_ufdest_p_icms_inter_part"/>
                                                <field name="icms_ufdest_v_fcp_uf_dest"/>
                                                <field name="icms_ufdest_v_icms_uf_dest"/>
                                                <field name="icms_ufdest_v_icms_uf_remet"/>
                                            </group>
                                            <group string="ICMS ST Repasse (Interestadual)">
                                                <field name="icmsst_rep_orig"/>
                                                <field name="icmsst_rep_cst"/>
                                                <field name="icmsst_rep_v_bc_st_ret"/>
                                                <field name="icmsst_rep_p_st"/>
                                                <field name="icmsst_rep_v_icms_substituto"/>
                                                <field name="icmsst_rep_v_icms_st_ret"/>
                                                <field name="icmsst_rep_v_bc_fcp_st_ret"/>
                                                <field name="icmsst_rep_p_fcp_st_ret"/>
                                                <field name="icmsst_rep_v_fcp_st_ret"/>
                                                <field name="icmsst_rep_v_bc_st_dest"/>
                                                <field name="icmsst_rep_v_icms_st_dest"/>
                                                <field name="icmsst_rep_p_red_bc_efet"/>
                                                <field name="icmsst_rep_v_bc_efet"/>
                                                <field name="icmsst_rep_p_icms_efet"/>
                                                <field name="icmsst_rep_v_icms_efet"/>
                                            </group>
                                        </group>
                                        <group string="IPI">
                                            <group string="Identificação">
                                                <field name="ipi_cst"/>
                                                <field name="ipi_cl_enq"/>
                                                <field name="ipi_cnpj_prod"/>
                                                <field name="ipi_c_enq"/>
                                                <field name="ipi_c_selo"/>
                                                <field name="ipi_q_selo"/>
                                            </group>
                                            <group string="Tributação">
                                                <field name="ipi_v_bc"/>
                                                <field name="ipi_p_ipi"/>
                                                <field name="ipi_q_unid"/>
                                                <field name="ipi_v_unid"/>
                                                <field name="ipi_v_ipi"/>
                                            </group>
                                        </group>
                                        <group string="COFINS">
                                            <field name="cofins_cst"/>
                                            <field name="cofins_v_bc"/>
                                            <field name="cofins_p_cofins"/>
                                            <field name="cofins_q_bc_prod"/>
                                            <field name="cofins_v_aliq_prod"/>
                                            <field name="cofins_v_cofins"/>
                                        </group>
                                        <group string="PIS">
                                            <field name="pis_cst"/>
                                            <field name="pis_v_bc"/>
                                            <field name="pis_p_pis"/>
                                            <field name="pis_q_bc_prod"/>
                                            <field name="pis_v_aliq_prod"/>
                                            <field name="pis_v_pis"/>
                                        </group>
                                        <group string="PIS ST">
                                            <field name="pisst_v_bc"/>
                                            <field name="pisst_p_pis"/>
                                            <field name="pisst_q_bc_prod"/>
                                            <field name="pisst_v_aliq_prod"/>
                                            <field name="pisst_v_pis"/>
                                        </group>
                                        <group string="COFINS ST">
                                            <field name="cofinsst_v_bc"/>
                                            <field name="cofinsst_p_cofins"/>
                                            <field name="cofinsst_q_bc_prod"/>
                                            <field name="cofinsst_v_aliq_prod"/>
                                            <field name="cofinsst_v_cofins"/>
                                        </group>
                                        <group string="Tributos Devolvidos">
                                            <field name="devol_p_devol"/>
                                            <field name="devol_v_ipi_devol"/>
                                        </group>
                                        <group string="Imposto de Importação">
                                            <field name="ii_v_bc"/>
                                            <field name="ii_v_desp_adu"/>
                                            <field name="ii_v_ii"/>
                                            <field name="ii_v_iof"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dfe_proc_nfe" model="ir.actions.act_window">
        <field name="name">NF-e Processadas</field>
        <field name="res_model">l10n_br_dfe_monitor.proc_nfe</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
