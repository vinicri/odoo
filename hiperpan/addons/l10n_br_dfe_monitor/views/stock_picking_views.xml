<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_picking_form_dfe_nfe_escrit" model="ir.ui.view">
    <field name="name">stock.picking.form.dfe.nfe.escrit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">
      <field name="origin" position="after">
        <field name="dfe_nfe_escrit_id" invisible="not dfe_nfe_escrit_id"/>
      </field>
    </field>
  </record>

  <record id="vpicktree_dfe_nfe_escrit" model="ir.ui.view">
    <field name="name">stock.picking.list.dfe.nfe.escrit</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.vpicktree"/>
    <field name="arch" type="xml">
      <field name="origin" position="after">
        <field name="dfe_nfe_escrit_id" optional="hide"/>
      </field>
    </field>
  </record>
</odoo>
