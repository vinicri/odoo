<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_dfe_res_nfe_list" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.res_nfe.list</field>
        <field name="model">l10n_br_dfe_monitor.res_nfe</field>
        <field name="arch" type="xml">
            <list string="Resumos NF-e" decoration-success="c_sit_nfe == '1'" decoration-danger="c_sit_nfe == '2'" decoration-muted="c_sit_nfe == '3'">
                <field name="dh_recbto" string="Dt. Autorização"/>
                <field name="dh_emi" string="Dt. Emissão"/>
                <field name="ch_nfe"/>
                <field name="x_nome" string="Emitente"/>
                <field name="tp_nf"/>
                <field name="v_nf" string="Valor"/>
                <field name="c_sit_nfe"/>
                <field name="manifestacao"/>
                <field name="tp_amb"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_dfe_res_nfe_form" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.res_nfe.form</field>
        <field name="model">l10n_br_dfe_monitor.res_nfe</field>
        <field name="arch" type="xml">
            <form string="Resumo NF-e">
                <sheet>
                    <group string="Identificação">
                        <field name="ch_nfe"/>
                        <field name="versao"/>
                        <field name="tp_amb"/>
                        <field name="c_sit_nfe"/>
                        <field name="dfe_document_id"/>
                    </group>
                    <group string="Emitente">
                        <field name="emit_cnpj"/>
                        <field name="emit_cpf"/>
                        <field name="x_nome"/>
                        <field name="ie"/>
                    </group>
                    <group string="Dados da NF-e">
                        <field name="tp_nf"/>
                        <field name="v_nf"/>
                        <field name="dh_emi"/>
                        <field name="dh_recbto"/>
                        <field name="n_prot"/>
                        <field name="dig_val"/>
                    </group>
                    <group string="Manifestação do Destinatário">
                        <field name="manifestacao"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_dfe_res_nfe_kanban" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.res_nfe.kanban</field>
        <field name="model">l10n_br_dfe_monitor.res_nfe</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" records_draggable="0">
                <field name="id"/>
                <field name="ch_nfe"/>
                <field name="x_nome"/>
                <field name="tp_nf"/>
                <field name="v_nf"/>
                <field name="dh_emi"/>
                <field name="dh_recbto"/>
                <field name="c_sit_nfe"/>
                <field name="manifestacao"/>
                <field name="tp_amb"/>
                <field name="proc_nfe_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column justify-content-between align-items-start mb-1">
                            <div>
                                <strong class="o_kanban_record_title fs-6 mb-1">
                                    <t t-esc="record.x_nome.value"/>
                                </strong>
                            </div>
                            <div class="text-muted mb-1">
                                <span class="h5">
                                    <i class="fa fa-calendar me-1"/>
                                    <t t-esc="record.dh_emi.value"/>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between w-100">
                                <span t-attf-class="badge rounded-pill #{
                                record.manifestacao.raw_value === 'confirmado' ? 'text-bg-success' :
                                record.manifestacao.raw_value === 'ciencia' ? 'text-bg-info' :
                                record.manifestacao.raw_value === 'nao_realizada' ? 'text-bg-warning' :
                                record.manifestacao.raw_value === 'desconhecido' ? 'text-bg-secondary' :
                                'text-bg-light'
                            }">
                                    <t t-esc="record.manifestacao.value"/>
                                </span>
                                <span>
                                    <t t-if="record.c_sit_nfe.raw_value === '1'">
                                        <span class="badge text-bg-success">Autorizada</span>
                                    </t>
                                    <t t-elif="record.c_sit_nfe.raw_value === '2'">
                                        <span class="badge text-bg-danger">Denegada</span>
                                    </t>
                                    <t t-elif="record.c_sit_nfe.raw_value === '3'">
                                        <span class="badge text-bg-warning">Cancelada</span>
                                    </t>
                                </span>

                            </div>
                        </div>
                        <!-- <div class="text-muted small mb-1">
                            <i class="fa fa-key me-1"/>
                            <t t-esc="record.ch_nfe.value"/>
                        </div> -->
                        <div class="small">

                            <span>
                                <t t-if="record.tp_nf.raw_value === '0'">
                                    <span class="badge text-bg-primary">Entrada</span>
                                </t>
                                <t t-else="">
                                    <span class="badge text-bg-secondary">Saída</span>
                                </t>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mt-3">
                            <div class="oe_kanban_bottom_left">
                                <t t-if="record.proc_nfe_id.raw_value">
                                    <button name="action_open_proc_nfe" type="object" class="btn btn-sm btn-outline-primary" title="Ver NF-e Completa">
                                        <i class="fa fa-file-text-o"/>
 NF-e
                                    </button>
                                </t>
                                <t t-elif="record.manifestacao.raw_value === 'ciencia'">
                                    <span class="text-muted small" title="O XML completo da NF-e ficará disponível após o emitente declarar ciência junto à SEFAZ">
                                        <i class="fa fa-info-circle me-1"/>
NF-e pendente
                                    </span>
                                </t>
                                <t t-else="">
                                    <button class="btn btn-sm btn-outline-secondary" disabled="1" title="Nenhuma NF-e processada vinculada a este resumo">
                                        <i class="fa fa-file-text-o"/>
 NF-e
                                    </button>
                                </t>
                            </div>
                            <strong class="h2">
                                <t t-esc="record.v_nf.value"/>
                            </strong>
                        </div>

                        <div class="o_kanban_record_bottom mt-2">

                            <div class="oe_kanban_bottom_right">
                                <t t-if="record.manifestacao.raw_value === 'pendente'">
                                    <div class="btn-group">
                                        <button name="action_manifestar_ciencia" type="object" class="btn btn-sm btn-outline-info" title="Ciência da Operação">
                                            <i class="fa fa-eye"/>
 Ciência
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-info dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"/>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <button name="action_manifestar_ciencia" type="object" class="dropdown-item">
                                                    <i class="fa fa-eye me-2"/>
Ciência da Operação
                                                </button>
                                            </li>
                                            <li>
                                                <button name="action_manifestar_confirmado" type="object" class="dropdown-item">
                                                    <i class="fa fa-check me-2"/>
Confirmação da Operação
                                                </button>
                                            </li>
                                            <li>
                                                <button name="action_manifestar_nao_realizada" type="object" class="dropdown-item">
                                                    <i class="fa fa-times me-2"/>
Operação não Realizada
                                                </button>
                                            </li>
                                            <li>
                                                <button name="action_manifestar_desconhecido" type="object" class="dropdown-item">
                                                    <i class="fa fa-question me-2"/>
Desconhecimento
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </t>
                                <t t-if="record.manifestacao.raw_value === 'ciencia'">
                                    <button name="action_manifestar_confirmado" type="object" class="btn btn-sm btn-outline-success" title="Confirmar Operação">
                                        <i class="fa fa-check"/>
 Confirmar
                                    </button>
                                    <button name="action_manifestar_nao_realizada" type="object" class="btn btn-sm btn-outline-warning" title="Operação Não Realizada">
                                        <i class="fa fa-times"/>
 Não Realizada
                                    </button>
                                    <button name="action_manifestar_desconhecido" type="object" class="btn btn-sm btn-outline-secondary" title="Desconhecimento">
                                        <i class="fa fa-question"/>
 Desconhecido
                                    </button>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View with filters for manifestacao -->
    <record id="view_dfe_res_nfe_search" model="ir.ui.view">
        <field name="name">l10n_br_dfe_monitor.res_nfe.search</field>
        <field name="model">l10n_br_dfe_monitor.res_nfe</field>
        <field name="arch" type="xml">
            <search string="Buscar Resumos NF-e">
                <field name="ch_nfe" string="Chave"/>
                <field name="x_nome" string="Emitente"/>
                <separator/>
                <filter name="nao_manifestada" string="Pendente" domain="[('manifestacao', '=', 'pendente')]"/>
                <filter name="ciencia" string="Ciência" domain="[('manifestacao', '=', 'ciencia')]"/>
                <filter name="confirmado" string="Confirmada" domain="[('manifestacao', '=', 'confirmado')]"/>
                <filter name="nao_realizada" string="Não Realizada" domain="[('manifestacao', '=', 'nao_realizada')]"/>
                <filter name="desconhecido" string="Desconhecida" domain="[('manifestacao', '=', 'desconhecido')]"/>
                <separator/>
                <filter name="autorizada" string="Autorizada" domain="[('c_sit_nfe', '=', '1')]"/>
                <filter name="cancelada" string="Cancelada" domain="[('c_sit_nfe', '=', '3')]"/>
                <separator/>
                <filter name="entrada" string="Entradas" domain="[('tp_nf', '=', '0')]"/>
                <filter name="saida" string="Saídas" domain="[('tp_nf', '=', '1')]"/>
                <group expand="1" string="Agrupar por">
                    <filter name="group_manifestacao" string="Manifestação" context="{'group_by': 'manifestacao'}"/>
                    <filter name="group_c_sit_nfe" string="Situação NF-e" context="{'group_by': 'c_sit_nfe'}"/>
                    <filter name="group_tp_nf" string="Tipo" context="{'group_by': 'tp_nf'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_dfe_res_nfe" model="ir.actions.act_window">
        <field name="name">Resumos NF-e</field>
        <field name="res_model">l10n_br_dfe_monitor.res_nfe</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_dfe_res_nfe_search"/>
        <field name="context">{'search_default_company_id': True}</field>
    </record>

</odoo>
