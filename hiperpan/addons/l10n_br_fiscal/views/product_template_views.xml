<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="l10n_br_fiscal_product_template_form_view" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.product.template.form</field>
    <field name="model">product.template</field>
    <field name="priority" eval="4" />
    <field name="inherit_id" ref="product.product_template_only_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='sales']" position="before">
        <page name="fiscal_information" string="Fiscal Information">
          <group>
            <field name="fiscal_type_id" />
            <field name="icms_origin_id" />
            <field name="ncm_id" />
            <field name="fiscal_genre_id" />
            <field name="cest_id" />
            <field name="no_barcode" />
            <field name="fiscal_additional_information" />
          </group>
        </page>
        <page name="manufacture" string="Manufacture">
          <field name="bom_ids">
            <list>
              <field name="is_default_bom_for_product"/>
              <field name="code"/>
              <field name="type"/>
              <field name="product_qty"/>
              <field name="product_uom_id" groups="uom.group_uom"/>
            </list>
            <form>
              <group>
                <group>
                  <field name="is_default_bom_for_product"/>
                  <field name="code"/>
                  <field name="type"/>
                </group>
                <group>
                  <field name="product_qty"/>
                  <field name="product_uom_id" groups="uom.group_uom"/>
                </group>
              </group>
              <field name="bom_line_ids">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="product_id"/>
                  <field name="product_qty"/>
                  <field name="product_uom_id" groups="uom.group_uom"/>
                </list>
              </field>
            </form>
          </field>
        </page>
        <page name="icms" string="ICMS">
          <div class="mb-2 d-flex gap-2 justify-content-center">
            <button name="action_create_product_taxes" type="object" string="Definir imposto padrão" class="btn btn-primary" icon="fa-plus" invisible="product_tmpl_taxes"/>
            <button name="action_edit_product_taxes" type="object" string="Editar Imposto" class="btn btn-secondary" icon="fa-pencil" invisible="not product_tmpl_taxes"/>
            <button name="action_delete_product_taxes" type="object" string="Remover definição de imposto" class="btn btn-danger" icon="fa-trash" invisible="not product_tmpl_taxes" confirm="Deseja realmente remover a definição de imposto deste produto?"/>
          </div>
          <group invisible="not product_tmpl_taxes">
            <field name="product_tmpl_taxes" invisible="1" />
            <field name="product_taxes_icms_sn_tax_id" options="{'no_create': True, 'no_create_edit': True}" context="{'operation_type': '1'}"/>
            <field name="product_taxes_icms_sn_cst_nfe_code" />
            <field name="product_taxes_icms_tax_id" options="{'no_create': True, 'no_create_edit': True}" context="{'operation_type': '1'}"/>
          </group>
        </page>
        <page name="ipi" string="IPI" invisible="not has_ipi">
          <group>
            <field name="ipi_guideline_id" />
            <field name="ipi_tax_id" context="{'operation_type': '1', 'include_cst_name': True}" options="{'no_create': True, 'no_create_edit': True}"/>
            <field name="ipi_tax_percent" invisible="not is_ipi_with_percentage or is_ipi_qtt"/>

          </group>
        </page>

        <page name="piscofins" string="PIS COFINS">
          <group>
            <group>
              <field name="allowed_pis_tax_ids" invisible="1"/>
              <field name="pis_tax_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </group>
            <group>
              <field name="allowed_cofins_tax_ids" invisible="1"/>
              <field name="cofins_tax_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </group>
          </group>
        </page>
      </xpath>
      <xpath expr="//field[@name='ncm_id']" position="after">
        <xpath expr="//field[@name='barcode']" position="after">
          <field name="no_barcode" />
        </xpath>
      </xpath>
    </field>

  </record>

</odoo>
