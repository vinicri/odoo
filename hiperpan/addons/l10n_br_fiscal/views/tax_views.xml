<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="tax_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.tax.form</field>
    <field name="model">l10n_br_fiscal.tax</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div>
            <group>
              <field name="name" />
              <field name="description" />
            </group>
          </div>
          <group>
            <group>
              <field name="tax_group_id" />
              <field name="tax_scope" />
              <field name="tax_domain_id" />
              <field name="tax_base_type" />
              <field name="percent_amount" />
            </group>
            <group>
              <field name="cst_in_id" />
              <field name="cst_out_id" />
              <field name="table_date" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="tax_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.tax.list</field>
    <field name="model">l10n_br_fiscal.tax</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="description" />
        <field name="percent_amount" />
        <field name="tax_group_id" />
        <field name="tax_domain_id" />
        <field name="cst_in_id" />
        <field name="cst_out_id" />
      </list>
    </field>
  </record>

  <record id="tax_action" model="ir.actions.act_window">
    <field name="name">Imposto</field>
    <field name="res_model">l10n_br_fiscal.tax</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="tax_view_list" />
  </record>

</odoo>