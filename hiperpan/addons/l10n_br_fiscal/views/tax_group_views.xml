<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="tax_group_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.tax.group.form</field>
    <field name="model">l10n_br_fiscal.tax.group</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="tax_domain_id" />
              <field name="tax_scope" />
            </group>
            <group>
              <field name="tax_include" />
              <field name="tax_withholding" />
              <field name="base_with_additional_values" />
              <field name="wh_due_day" />
            </group>
          </group>
          <notebook>
            <page name="tax_group_page_tax" string="Impostos">
              <field name="tax_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="tax_group_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.tax.group.list</field>
    <field name="model">l10n_br_fiscal.tax.group</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="tax_domain_id" />
        <field name="tax_scope" />
      </list>
    </field>
  </record>

  <record id="tax_group_action" model="ir.actions.act_window">
    <field name="name">Grupo de Impostos</field>
    <field name="res_model">l10n_br_fiscal.tax.group</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="tax_group_view_list" />
  </record>

</odoo>