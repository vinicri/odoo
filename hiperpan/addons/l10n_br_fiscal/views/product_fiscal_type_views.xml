<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="product_fiscal_type_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.product.fiscal.type.form</field>
    <field name="model">l10n_br_fiscal.product.fiscal.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code" />
            <field name="name" />
            <field name="active" />
          </group>
          <notebook>
            <page name="product_fiscal_type_page_product" string="Produtos">
              <field name="product_template_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_fiscal_type_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.product.fiscal.type.list</field>
    <field name="model">l10n_br_fiscal.product.fiscal.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="product_fiscal_type_action" model="ir.actions.act_window">
    <field name="name">Product Fiscal Type</field>
    <field name="res_model">l10n_br_fiscal.product.fiscal.type</field>
    <field name="view_mode">form,list</field>
    <field name="view_id" ref="product_fiscal_type_view_list" />
  </record>

</odoo>