<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_partner_form_view" model="ir.ui.view">
    <field name="name">res.partner.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="priority" eval="102"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='accountant_info']" position="after">
        <page name="fiscal_info" string="Fiscal Info">
          <group>
            <field name="fiscal_framework" string="Fiscal Framework" />
            <field name="regular_framework_type" string="Tipo de regime normal" />
            <field name="ipi_contributes" string="Contribui com IPI" />
          </group>
        </page>
      </xpath>
      <xpath expr="//page[@name='fiscal_info']" position="after">
        <page name="freight_info" string="Transportadora">
          <group>
            <field name="is_freight_carrier" string="É transportadora" />
          </group>
          <label for="freight_carrier_vehicle_ids" string="Veículos de transporte" invisible="not is_freight_carrier" />
          <field name="freight_carrier_vehicle_ids" nolabel="1" invisible="not is_freight_carrier" context="{'partner_id_read_only': True}" />
        </page>
      </xpath>
    </field>
  </record>
</odoo>