<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="cnae_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.cnae.form</field>
    <field name="model">l10n_br_fiscal.cnae</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code" />
            <field name="name" />
            <field name="version" />
            <field name="parent_id" />
            <field name="internal_type" />
            <field name="active" />
          </group>
          <notebook>
            <page name="cnae_page_children" string="Subcategorias">
              <field name="child_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="cnae_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.cnae.list</field>
    <field name="model">l10n_br_fiscal.cnae</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="version" />
        <field name="parent_id" />
        <field name="internal_type" />
      </list>
    </field>
  </record>

  <record id="cnae_action" model="ir.actions.act_window">
    <field name="name">CNAE</field>
    <field name="res_model">l10n_br_fiscal.cnae</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="cnae_view_list" />
  </record>

</odoo>