<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="cest_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.cest.form</field>
    <field name="model">l10n_br_fiscal.cest</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code" />
            <field name="name" />
            <field name="item" />
            <field name="segment" />
          </group>
          <notebook>
            <page name="cest_page_product" string="Produtos">
              <field name="product_tmpl_ids" />
            </page>
            <page name="cest_page_ncm" string="NCMs">
              <field name="ncm_ids" />
            </page>

          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="cest_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.cest.list</field>
    <field name="model">l10n_br_fiscal.cest</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="item" />
        <field name="segment" />
      </list>
    </field>
  </record>

  <record id="cest_action" model="ir.actions.act_window">
    <field name="name">CEST</field>
    <field name="res_model">l10n_br_fiscal.cest</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="cest_view_list" />
  </record>

</odoo>