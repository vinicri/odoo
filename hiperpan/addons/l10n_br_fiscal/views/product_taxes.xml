<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_product_taxes_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.product.taxes.form</field>
    <field name="model">l10n_br_fiscal.product.taxes</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <separator string="ICMS Simples Nacional"/>
            <field name="product_id" invisible="1"/>
            <field name="product_tmpl_id" invisible="1"/>
            <field name="company_id" invisible="1"/>
            <field name="icms_sn_tax_id" options="{'no_create': True, 'no_create_edit': True}" context="{'operation_type': '1'}"/>
            <field name="icms_sn_cst_nfe_code" />
          </group>

          <group>
            <separator string="ICMS"/>
            <field name="icms_tax_id" options="{'no_create': True, 'no_create_edit': True}" context="{'operation_type': '1'}"/>
            <field name="icms_cst_nfe_code" />
            <field name="icms_cst_code" invisible="1"/>
            <field name="has_icms_own_operation" invisible="1"/>
            <field name="is_deferment_cst" invisible="1"/>
            <field name="is_icms_with_base_reduction" invisible="1"/>
            <field name="icms_bc_modality" invisible="not has_icms_own_operation"/>
            <field name="icms_bc_reduction_percent" invisible="not is_icms_with_base_reduction"/>
            <field name="icms_tax_percent" invisible="not has_icms_own_operation"/>
            <field name="icms_deferment_percent" invisible="not is_deferment_cst"/>





          </group>
          <group invisible="not has_icms_own_operation">
            <separator string="FCP" />
            <field name="icms_fcp_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
            <field name="icms_fcp_tax_percent" />
          </group>

          <group invisible="not is_icms_st">
            <separator string="ICMS ST"/>
            <field name="icms_st_modality" />
            <field name="icms_st_mva_percent" invisible="not is_icms_st_mva_modality" />
            <field name="icms_st_reduction_percent" />
            <field name="icms_st_tax_percent" />

            <field name="icms_st_fcp_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
            <field name="icms_st_fcp_tax_percent" />
          </group>


          <group>
            <separator string="PIS COFINS"/>
            <field name="pis_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
            <field name="cofins_tax_id" options="{'no_create': True, 'no_create_edit': True}" />
          </group>

          <group>
            <separator string="IPI"/>
            <field name="ipi_guideline_id" />
            <field name="ipi_tax_id" options="{'no_create': True, 'no_create_edit': True}" context="{'operation_type': '1', 'include_cst_name': True}" />
            <field name="ipi_tax_percent" invisible="not is_ipi_with_percentage" />
          </group>


        </sheet>
      </form>
    </field>

  </record>

  <record id="view_product_taxes_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.product.taxes.list</field>
    <field name="model">l10n_br_fiscal.product.taxes</field>
    <field name="arch" type="xml">
      <list>
        <!-- <field name="product_id" />
        <field name="product_tmpl_id" />
        <field name="company_id" /> -->
        <field name="icms_sn_tax_id" />
        <field name="icms_sn_cst_nfe_code" />
        <field name="icms_tax_id" context="{'operation_type': '1'}"/>
      </list>
    </field>
  </record>


  <record id="product_taxes_action" model="ir.actions.act_window">
    <field name="name">Product Taxes</field>
    <field name="res_model">l10n_br_fiscal.product.taxes</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_product_taxes_list" />
  </record>
</odoo>