<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="cst_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.cst.form</field>
    <field name="model">l10n_br_fiscal.cst</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="tax_domain_id" />
            <field name="code" />
            <field name="name" />
            <field name="cst_type" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="cst_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.cst.list</field>
    <field name="model">l10n_br_fiscal.cst</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="cst_type" />
        <field name="tax_domain_id" />
      </list>
    </field>
  </record>

  <record id="cst_action" model="ir.actions.act_window">
    <field name="name">CST</field>
    <field name="res_model">l10n_br_fiscal.cst</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="cst_view_list" />
  </record>
</odoo>