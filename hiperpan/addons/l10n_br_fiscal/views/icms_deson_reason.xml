<odoo>
  <record id="icms_deson_reason_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.icms.deson.reason.form</field>
    <field name="model">l10n_br_fiscal.icms.deson.reason</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="code" />
              <field name="name" />
              <field name="active" />
            </group>
            <group>
              <field name="cst_ids" widget="many2many_tags" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="icms_deson_reason_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.icms.deson.reason.list</field>
    <field name="model">l10n_br_fiscal.icms.deson.reason</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="cst_ids" widget="many2many_tags" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="icms_deson_reason_action" model="ir.actions.act_window">
    <field name="name">Motivo da Desoneração do ICMS</field>
    <field name="res_model">l10n_br_fiscal.icms.deson.reason</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="icms_deson_reason_view_list" />
  </record>

</odoo>