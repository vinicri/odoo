<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="tax_domain_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.tax.domain.form</field>
    <field name="model">l10n_br_fiscal.tax.domain</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="code" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="tax_domain_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.tax.domain.list</field>
    <field name="model">l10n_br_fiscal.tax.domain</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="code" />
      </list>
    </field>
  </record>

  <record id="tax_domain_action" model="ir.actions.act_window">
    <field name="name">Tax Domain</field>
    <field name="res_model">l10n_br_fiscal.tax.domain</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="tax_domain_view_list" />
  </record>

</odoo>