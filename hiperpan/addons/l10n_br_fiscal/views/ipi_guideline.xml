<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="ipi_guideline_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.ipi.guideline.form</field>
    <field name="model">l10n_br_fiscal.ipi.guideline</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code" />
            <field name="name" />
            <field name="ipi_cst_in" />
            <field name="ipi_cst_out" />
            <field name="active" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ipi_guideline_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.ipi.guideline.list</field>
    <field name="model">l10n_br_fiscal.ipi.guideline</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="ipi_cst_in" />
        <field name="ipi_cst_out" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="ipi_guideline_action" model="ir.actions.act_window">
    <field name="name">IPI Guideline</field>
    <field name="res_model">l10n_br_fiscal.ipi.guideline</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="ipi_guideline_view_list" />
  </record>

</odoo>