<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <record id="ncm_genre_view_form" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.ncm.genre.form</field>
    <field name="model">l10n_br_fiscal.ncm.genre</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="code" />
            <field name="name" />
            <field name="active" />
          </group>
          <notebook>
            <page name="ncm_genre_page_product" string="Produtos">
              <field name="product_tmpl_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ncm_genre_view_list" model="ir.ui.view">
    <field name="name">l10n_br_fiscal.ncm.genre.list</field>
    <field name="model">l10n_br_fiscal.ncm.genre</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" />
        <field name="name" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="ncm_genre_action" model="ir.actions.act_window">
    <field name="name">NCM Genre</field>
    <field name="res_model">l10n_br_fiscal.ncm.genre</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="ncm_genre_view_list" />
  </record>

</odoo> 