<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_product_default_code" model="ir.sequence">
        <field name="name">Product Default Code</field>
        <field name="code">l10n_br_fiscal.product.default_code</field>
        <field name="implementation">no_gap</field>
        <field name="padding">0</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <!-- Shared numbering across all companies: next_by_code only matches
             a sequence whose company_id is either the current company or
             False, so this must stay company-independent. -->
        <field name="company_id" eval="False"/>
    </record>
</odoo>
