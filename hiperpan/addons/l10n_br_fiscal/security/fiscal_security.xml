<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record id="module_category_l10n_br_fiscal_management" model="ir.module.category">
    <field name="name">Brazilian Fiscal</field>
    <field name="description">Fiscal module for Brazil</field>
    <field name="sequence">30</field>
  </record>

  <record id="group_user_fiscal" model="res.groups">
    <field name="name">Fiscal User</field>
    <field name="category_id" ref="module_category_l10n_br_fiscal_management" />
  </record>

  <record id="group_fiscal_manager" model="res.groups">
    <field name="name">Fiscal Manager</field>
    <field name="category_id" ref="module_category_l10n_br_fiscal_management" />
    <field name="implied_ids" eval="[(4, ref('l10n_br_fiscal.group_user_fiscal'))]" />
  </record>




</odoo>
