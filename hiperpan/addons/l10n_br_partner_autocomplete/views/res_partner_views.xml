<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_form_view" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@id='company']" position="replace">
                <!-- New partner: show custom field (no id yet) -->
                <field id="search_cnpj_cpf" name="search_cnpj_cpf" options="{'line_breaks': False}" placeholder="CNPJ para procurar" widget="text" class="text-break" default_focus="1" invisible="id or not is_company" required="type == 'contact'"/>
                <!-- Existing partner: restore original field -->
                <field id="company" name="name" options="{'line_breaks': False}" widget="text" class="text-break" default_focus="1" placeholder="e.g. Lumber Inc" invisible="not id or not is_company" required="type == 'contact'"/>
            </xpath>
        </field>
    </record>


</odoo>




